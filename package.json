{
  "name": "teamshelf",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @teamshelf/web dev",
    "dev:mock": "pnpm --filter @teamshelf/web dev:mock",
    "dev:back-office": "pnpm --filter @teamshelf/back-office dev",
    "build": "turbo run build",
    "preview": "pnpm --filter @teamshelf/web preview",
    "lint": "oxlint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:build": "turbo run test:build",
    "db:migrate": "node db/migrate.mjs",
    "cloud": "node scripts/setup.mjs"
  },
  "devDependencies": {
    "dotenv": "^18.0.10",
    "oxlint": "^1.90.0",
    "pg": "^8.23.1",
    "turbo": "^2.11.13"
  },
  "packageManager": "pnpm@12.4.1"
}
