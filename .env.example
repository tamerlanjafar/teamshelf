# Used only by `pnpm db:migrate`. Never shipped to the browser.
# Neon Console → Connect → turn "Connection pooling" off.
DATABASE_URL=""

# Public: the browser signs in and reads data through these.
# Neon Console → Auth → Configuration, and Data API.
VITE_NEON_AUTH_URL=""
VITE_NEON_DATA_API_URL=""

# Files (Cloudflare R2). Used by the server functions in netlify/functions. Set them in Netlify
# too (Site settings → Environment variables); netlify.toml is not read by functions.
# Cloudflare → R2 → Manage API tokens: a token with Object Read & Write on the bucket.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# Only for the daily file cleanup (netlify/functions/file-cleanup.mjs): the database user
# "teamshelf_files", which can only read and clear the list of deleted files.
FILE_CLEANUP_DATABASE_URL=""


# Features that are built but switched off. See src/lib/features.ts.
# VITE_PERSONAL_ORDER=true
