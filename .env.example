# One file for the whole repository. `pnpm cloud` fills it in (SETUP.md); nothing here is shipped
# to the browser except the VITE_ values, which are public anyway.

# Neon. DATABASE_URL is only for `pnpm db:migrate` on your own machine (Connect → pooling off).
NEON_PROJECT_ID=""
DATABASE_URL=""
VITE_NEON_AUTH_URL=""
VITE_NEON_DATA_API_URL=""

# Where the app is served, for canonical links and the sitemap. On Netlify its own URL is used.
VITE_SITE_URL=""

# Files (Cloudflare R2). Optional: without them the app keeps links only.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# The daily file cleanup connects as the database user "teamshelf_files", which can only read
# and clear the list of deleted files.
FILE_CLEANUP_DATABASE_URL=""
